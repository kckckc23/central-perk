# ---------------------------------------------------------------------------
# SpotSync environment configuration
#
# Copy this file to `.env` and fill in values. No real secrets belong in
# version control. Every public endpoint below is a community/open service
# that may be replaced with a self-hosted instance.
# ---------------------------------------------------------------------------

# --- PocketBase (server-side only; never expose admin credentials) ---------
# URL of your self-hosted PocketBase instance.
POCKETBASE_URL=http://127.0.0.1:8090

# Superuser credentials used by the server to manage collections and data.
# Create the first superuser in the PocketBase admin UI (http://127.0.0.1:8090/_/)
# then put those credentials here. Used server-side only.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# --- Map -------------------------------------------------------------------
# MapLibre style URL (OpenFreeMap-compatible or your own self-hosted style).
# Defaults to the OpenFreeMap "liberty" style when empty.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Geocoding (Photon-compatible endpoint) ----------------------------------
# Public demo endpoint; self-host for sustained use.
PHOTON_BASE_URL=https://photon.komoot.io/api/

# --- Venue discovery (Overpass-compatible endpoint) ------------------------
# Public demo endpoint; respect its usage policy and self-host for sustained use.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# --- Routing (optional; leave ROUTING_PROVIDER=haversine for straight-line)
# ROUTING_PROVIDER: "haversine" | "valhalla" | "osrm"
ROUTING_PROVIDER=haversine
VALHALLA_BASE_URL=
OSRM_BASE_URL=

# --- Session cookie signing (development fallback only) -----------------------
# Random string used to sign guest session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production always set a real value.
SESSION_SECRET=
