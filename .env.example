# Copy to .env for local development: cp .env.example .env
# On Vercel, set these in Project → Settings → Environment Variables.

# --- Required ---
# Neon Serverless Postgres connection string.
# Create it via the Vercel Marketplace (Project → Storage → Neon)
# and Vercel sets DATABASE_URL for you.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Random 64-char hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL used in invite links (set automatically on Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional (open data, keyless) ---
# Geocoding (Photon). Default: https://photon.komoot.io/api
# (the public instance serves its API under /api; the
# root is an HTML page. Self-hosted instances serve
# the API at the root, which the app also handles.)
PHOTON_BASE_URL=
# Venue data (Overpass). Default: https://overpass-api.de/api/interpreter
# Leave empty to use a clearly-labelled deterministic demo dataset.
OVERPASS_BASE_URL=
# Map style URL. Default: a dark OpenFreeMap style.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Optional (self-hosted routing) ---
# Routing engine: haversine (default) | valhalla | osrm
ROUTING_PROVIDER=
VALHALLA_BASE_URL=
OSRM_BASE_URL=
